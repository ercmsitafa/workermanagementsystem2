# Copy this file to .env and set values for your local environment.
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-this-with-a-long-random-secret

# XAMPP MySQL (defaults commonly use root with an empty password locally)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workermanagementsystem
DB_CONNECTION_LIMIT=10

# IMPORTANT:
# The current application still uses backend/database.sqlite.
# Do not switch the application to MySQL until the migration has been reviewed,
# the SQLite file has been backed up, and migrated row counts have been verified.
